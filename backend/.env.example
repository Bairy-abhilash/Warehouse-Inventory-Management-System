# Copy this file to .env and replace values as needed

APP_HOST=127.0.0.1
APP_PORT=8000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/inventory_db

# Security & JWT Configuration
SECRET_KEY=dev-only-secret-change-me-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
